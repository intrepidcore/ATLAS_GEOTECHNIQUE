{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "atlas-pro",
  "version": "1.0.1",
  "identifier": "com.intrepidcore.atlas",
  "build": {
    "beforeDevCommand": "npm --prefix ../../ui run dev -- --host 127.0.0.1 --port 1420",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ../../ui run build",
    "frontendDist": "../../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "atlas-pro",
        "width": 800,
        "height": 600
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["msi"],
    "externalBin": ["bin/api-geo"],
    "resources": ["pg/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCNjM1NTY5ODZCN0RBQzcKUldUSDJyZUdhVlZqbTZybmJzd20xRWJkUWFzTFZ4V1RscFRVTGd5ZEZaNVpkVlQ5T3dDUWVkU1gK",
      "endpoints": [
        "https://github.com/intrepidcore/atlas-geotechnique/releases/latest/download/latest.json"
      ]
    }
  }
}
