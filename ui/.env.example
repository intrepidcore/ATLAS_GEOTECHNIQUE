# .env.local (à créer depuis .env.example, jamais commité)

# Port de l'API en développement local
# En production Tauri, cette valeur est injectée dynamiquement par lib.rs
# Ne pas hardcoder cette valeur dans index.html ou main.ts
VITE_API_BASE=http://127.0.0.1:8000/api

# Version de l'app (auto-générée par le build, ne pas modifier)
VITE_APP_VERSION=1.0.1

# Clés cartographiques (optionnelles — des fonds OpenStreetMap fonctionnent sans)
VITE_MAPBOX_TOKEN=
VITE_AZURE_MAPS_KEY=
