# ===========================================
# Atlas UI - Configuration d'environnement
# ===========================================
# Copiez ce fichier vers .env.local et adaptez les valeurs

# Mode développement local (localhost)
VITE_API_BASE=http://localhost:8000
VITE_API_GEO=http://localhost:8000
VITE_TILES_URL=http://localhost:8081

# Mode réseau local (pour tester sur mobile/autre appareil)
# Remplacez X.X.X.X par l'IP de votre machine
# VITE_API_BASE=http://X.X.X.X:8000
# VITE_API_GEO=http://X.X.X.X:8000
# VITE_TILES_URL=http://X.X.X.X:8081

# ===========================================
# Fonds de carte (optionnels)
# ===========================================
# OSM et ESRI fonctionnent sans clé
# Mapbox et Azure nécessitent une inscription

# Mapbox - https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=

# Azure Maps - https://portal.azure.com (créer ressource Azure Maps)
VITE_AZURE_MAPS_KEY=

# Alias legacy (compat): certaines configs historiques utilisent PS_KEY
VITE_PS_KEY=
