# Common
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas
POSTGRES_DB=atlas_clean
DATABASE_URL=postgres://atlas:atlas@db:5432/atlas_clean

# DB Manager (admin pool)
# Disabled by default; enable explicitly in local .env.
ENABLE_DB_MANAGER=false
DATABASE_URL_ADMIN=postgres://atlas_etl_user:${ATLAS_DB_ETL_PASSWORD}@db:5432/atlas_clean

# DB service users (recommended: set strong passwords in local `.env`, never commit secrets)
ATLAS_DB_APP_PASSWORD=
ATLAS_DB_READONLY_PASSWORD=
ATLAS_DB_ETL_PASSWORD=

# API GEO
API_GEO_PORT=8000
RUST_LOG=info,sqlx=warn,axum::rejection=trace

# API INFER
API_INFER_PORT=8000
MODEL_PATH=/models/model.onnx

# API OPTI (optimisation campagne AG + stratégie fondations ; port local courant 8011)
API_OPTI_PORT=8011

# Façade api-geo → microservices IA (les services api-infer / api-opti démarrent avec docker compose up)
# Laisser vide = exécution Python locale dans api-geo quand les URLs ne sont pas définies
# ATLAS_API_INFER_URL=http://127.0.0.1:8002
# Hôte Docker : service api-opti exposé sur 127.0.0.1:8003 (voir docker-compose.yml)
# ATLAS_API_OPTI_URL=http://127.0.0.1:8003
# ATLAS_INTERNAL_SERVICE_TOKEN=change-me-in-production

# Tests scripts/verify_campaign_pipeline_stable.py (optionnel)
# API_GEO_BASE=http://127.0.0.1:8000
# ATLAS_TEST_EMAIL=admin@atlas.local
# ATLAS_TEST_PASSWORD=
# ATLAS_TEST_JWT=

# UI
VITE_API_GEO=http://127.0.0.1:8001
VITE_API_INFER=http://127.0.0.1:8002
VITE_API_OPTI=http://127.0.0.1:8003

# GMAIL TOKEN
# Ces variables sont des exemples (placeholders) : à renseigner dans un fichier local `.env` (ignoré par git).
# Ne jamais committer de mots de passe / app passwords.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM=
# true/false : si true, le worker enregistre des logs mais n'envoie pas de mails.
COLAB_NOTIFY_DRY_RUN=
# Sujet du mail (optionnel)
COLAB_NOTIFY_SUBJECT=
# Instructions ajoutées au mail (optionnel)
COLAB_NOTIFY_INSTRUCTIONS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Atlas Mobile (docs/mobile) — rayon de tolérance par défaut (mètres) pour
# confirmer un point de prélèvement prévu, surchargeable par mission
# (atlas.colab_missions.sondage_tolerance_m). Fallback ultime si absent : 15.
ATLAS_DEFAULT_SONDAGE_TOLERANCE_M=15

# .atlaspack — paquets opérateur hors-ligne (docs/mobile/ATLASPACK_SERVERLESS.md).
# Clé PRIVÉE Ed25519 de signature, seed 32 octets en base64 standard.
# Ne JAMAIS committer de vraie valeur ici — uniquement dans .env local/secret.
# Générer via : cargo run --manifest-path services/api-geo/Cargo.toml --bin generate_atlaspack_keys
ATLASPACK_SIGNING_PRIVATE_KEY_B64=
# Durée de validité d'un paquet fraîchement généré (jours). Défaut code : 30.
ATLASPACK_EXPIRY_DAYS=
# Marge géographique (mètres) autour des missions pour les tuiles hors-ligne. Défaut code : 800.
ATLASPACK_MAP_MARGIN_M=
# Plage de zoom des tuiles hors-ligne embarquées. Défauts code : 12 / 17.
ATLASPACK_TILE_ZOOM_MIN=
ATLASPACK_TILE_ZOOM_MAX=
# Garde-fou nombre max de tuiles par paquet (réduit le zoom max si dépassé). Défaut code : 15000.
ATLASPACK_TILE_MAX_COUNT=
# User-Agent obligatoire pour l'usage des tuiles OpenStreetMap (politique OSM) — mets une vraie adresse de contact en production.
ATLASPACK_TILE_USER_AGENT=