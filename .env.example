# Common
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas
POSTGRES_DB=atlas_clean
DATABASE_URL=postgres://atlas:atlas@db:5432/atlas_clean

# DB Manager (admin pool)
# Disabled by default; enable explicitly in local .env.
ENABLE_DB_MANAGER=false
DATABASE_URL_ADMIN=postgres://atlas_etl_user:${ATLAS_DB_ETL_PASSWORD}@db:5432/atlas_clean

# DB service users (recommended: set strong passwords in local `.env`, never commit secrets)
ATLAS_DB_APP_PASSWORD=
ATLAS_DB_READONLY_PASSWORD=
ATLAS_DB_ETL_PASSWORD=

# API GEO
API_GEO_PORT=8000
RUST_LOG=info,sqlx=warn,axum::rejection=trace

# API INFER
API_INFER_PORT=8000
MODEL_PATH=/models/model.onnx

# API OPTI
API_OPTI_PORT=8000

# UI
VITE_API_GEO=http://127.0.0.1:8001
VITE_API_INFER=http://127.0.0.1:8002
VITE_API_OPTI=http://127.0.0.1:8003

# GMAIL TOKEN
# Ces variables sont des exemples (placeholders) : à renseigner dans un fichier local `.env` (ignoré par git).
# Ne jamais committer de mots de passe / app passwords.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM=
# true/false : si true, le worker enregistre des logs mais n'envoie pas de mails.
COLAB_NOTIFY_DRY_RUN=
# Sujet du mail (optionnel)
COLAB_NOTIFY_SUBJECT=
# Instructions ajoutées au mail (optionnel)
COLAB_NOTIFY_INSTRUCTIONS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=