# ===========================================
# Atlas API-GEO - Configuration d'environnement
# ===========================================
# Copiez ce fichier vers .env.local et adaptez les valeurs

# Base de données PostgreSQL/PostGIS
DATABASE_URL=postgres://atlas:atlas@localhost:5432/atlas

# Port d'écoute de l'API
PORT=8000

# Adresse d'écoute (0.0.0.0 pour accepter les connexions externes)
HOST=0.0.0.0

# Niveau de log (debug, info, warn, error)
RUST_LOG=info

# JWT Secret (à changer en production!)
JWT_SECRET=your-secret-key-change-in-production

# CORS origins autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
