  "query": "\n        SELECT \n            s.id,\n            s.code,\n            s.date,\n            s.source,\n            s.adm1_name,\n            s.adm2_name,\n            s.adm3_name,\n            s.created_at,\n            (SELECT COUNT(*) FROM essais WHERE sondage_id = s.id AND deleted_at IS NULL) as \"n_essais!\"\n        FROM sondages_non_geocodes s\n        ORDER BY s.created_at DESC\n        ",
